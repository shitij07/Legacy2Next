APP_NAME=Legacy2Next
VERSION=0.1.0
DEBUG=true

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legacy2next

SECRET_KEY=change-this-to-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

UPLOAD_ROOT=uploads
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_REQUEST=100
MAX_REQUEST_SIZE_MB=500
MAX_PROJECT_STORAGE_GB=5

AI_ENABLED=True
AI_PROVIDER=litellm
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=60
